report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# Figures the notebooks render from their 20k-comment subsample
report/figures/notebook_*

# Slides build products
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/*.fls
slides/*.fdb_latexmk
slides/*.vrb
slides/ornament.png

# PowerPoint lock files
~$*
